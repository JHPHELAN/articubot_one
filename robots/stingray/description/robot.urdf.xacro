<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro"  name="robot">

    <!-- See common Gazebo pugins in the world file -->
    
    <!--
        To re-generate robot.urdf.generated.xml manually for troubleshooting:
          cd ~/robot_ws
          colcon build
          xacro install/articubot_one/share/articubot_one/robots/stingray/description/robot.urdf.xacro sim_mode:=false > src/articubot_one/robots/stingray/description/robot.urdf.generated.xml
    -->

    <!-- 
             The *.xacro files are moved here because robot_description topic is published on the Desktop, not the robot RPi
    -->

    <xacro:include filename="../../../description/inertial_macros.xacro" />

    <xacro:include filename="../../../description/common_properties.xacro" />

    <xacro:include filename="stingray_properties.xacro" />
    <xacro:include filename="robot_core.xacro" />

    <xacro:property name="imu_offset_x" value="0.0"/>
    <xacro:property name="imu_offset_y" value="0.0"/>
    <xacro:property name="imu_offset_z" value="0.0"/>
    <xacro:property name="imu_rotation_x" value="0.0"/>
    <xacro:property name="imu_rotation_y" value="0.0"/>
    <!-- Note: imu_rotation_z has no effect on heading because EKF uses yaw_velocity only (imu0 yaw=false) -->
    <xacro:property name="imu_rotation_z" value="0.0"/>

    <!-- <xacro:property name="imu_visual_size" value="0.01"/> -->
    <!-- <xacro:include filename="../../../description/BNOxxx_imu.xacro" /> -->
    <xacro:include filename="BNOxxx_imu.xacro" />

    <!-- Note: regular camera and depth camera share chassis' "camera_link". Use one or another.  -->
    <!-- xacro:include filename="stingray_camera.xacro" / -->
    <!-- <xacro:include filename="stingray_depth_camera.xacro" /> -->
    <!-- OAK-D Camera -->
    <!-- <xacro:include filename="$(find articubot_one)/robots/stingray/description/oakd.xacro" /> -->
    <xacro:include filename="$(find articubot_one)/description/oakd.xacro" />
    <xacro:oakd_link mount_point="front_panel"/>
    <!-- 2026-10-03: pitch 0 -> 0.024 -> 0.027 rad (~1.55 deg nose-down). The anti-roll
         mount screws tip the camera forward; the OAK floor plane was measured rising ~1.4
         deg with range (drydock, level chassis) while the model assumed level, so the
         costmap saw a sloped floor. 0.024 rad flattened it to a +0.17 deg residual (on
         tile, table in far bins), so +0.17 deg -> 0.027 rad to zero it. Positive pitch =
         nose-down (parent base_link, +x fwd). The 0.17 deg is within measurement noise
         (~6 mm/2 m); re-verify with the floor-flatness probe on CLEAN floor (no table
         ahead) and adjust until slope ~ 0 (flip sign if it worsens). -->
    <xacro:oakd_joint x="0.023" y="0.01" z="0.030" roll="0" pitch="0.027" yaw="0" mount_point="front_panel"/>


    <!-- LDLidar configuration - ldlidar must be included before support to define properties -->
    <xacro:include filename="ldlidar.xacro" />
    <xacro:include filename="ldlidar_support.xacro" />

    <xacro:include filename="ros2_control.xacro" />

    <xacro:property name="open_circuit_voltage" value="14.0"/>
    <xacro:property name="battery_capacity" value="2.5"/>
    <xacro:include filename="Zeee_LiPo_battery.xacro" />

    <!-- USB accessories (added 2026-06-29) -->
    <xacro:include filename="usb_hub.xacro" />
    <xacro:include filename="usb_audio.xacro" />
    <xacro:include filename="usb_wifi_antenna.xacro" />
    <xacro:include filename="speaker.xacro" />
    <xacro:include filename="estop.xacro" />

</robot>