<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- *********************** USB HUB *********************************  -->
    <!-- Self-powered 4-port USB-2 hub (replacement for Atmel 03eb:0902).   -->
    <!-- Measured 4.13" L x 1.18" W x 0.35" H = 0.105 x 0.030 x 0.009 m.    -->
    <!-- Long edge runs fore-aft (X). Mounted on the underside of the       -->
    <!-- chassis tray, centered behind base_link.                           -->

    <xacro:property name="usb_hub_length" value="0.105"/>
    <xacro:property name="usb_hub_width"  value="0.030"/>
    <xacro:property name="usb_hub_height" value="0.009"/>

    <xacro:property name="usb_hub_x" value="-0.210"/>
    <xacro:property name="usb_hub_y" value="0.035"/>
    <xacro:property name="usb_hub_z" value="0.000"/>

    <!-- rpy="pi/2 0 0" : hub mounted on edge so 0.030 m face is vertical (Z),
         0.009 m face runs in Y. Long 0.105 m edge stays along X. -->
    <joint name="usb_hub_joint" type="fixed">
        <parent link="chassis_link"/>
        <child link="usb_hub_link"/>
        <origin xyz="${usb_hub_x} ${usb_hub_y} ${usb_hub_z}" rpy="${pi/2} 0 0"/>
    </joint>

    <link name="usb_hub_link">
        <visual>
            <geometry>
                <box size="${usb_hub_length} ${usb_hub_width} ${usb_hub_height}"/>
            </geometry>
            <material name="black"/>
        </visual>
    </link>

</robot>
